# --- GitHub auth (pick one) -------------------------------------------------
# App auth is what the deployed webhook should use.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID=

# Token auth is what Actions and local scripts use.
GITHUB_TOKEN=

# --- Secrets ----------------------------------------------------------------
# Must match the GitHub App webhook secret.
GITHUB_WEBHOOK_SECRET=
# Required header value (x-frapp-gh-secret) for POST /api/v1/cycle/*.
FRAPP_GH_CRON_SECRET=

# --- Config source ----------------------------------------------------------
# Either point at the repo holding frapp-gh.config.json...
FRAPP_GH_OWNER=ZAODEVZ
FRAPP_GH_REPO=ZAOfractal
# ...or inline the whole config (takes precedence).
# FRAPP_GH_CONFIG={"community":"The ZAO", ...}
