{
  "name": "frapp-gh",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "GitHub-native async fractal governance (ZAO Respect Game on Issues, Discussions, Projects)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cycle:open": "tsx scripts/cycle.ts open",
    "cycle:snapshot": "tsx scripts/cycle.ts snapshot",
    "cycle:tally": "tsx scripts/cycle.ts tally",
    "tally:local": "tsx scripts/tally.ts",
    "setup": "tsx scripts/setup.ts",
    "replay": "tsx scripts/replay.ts"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.3",
    "@octokit/graphql": "^8.1.1",
    "@octokit/rest": "^21.0.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@hono/node-server": "^1.13.7"
  }
}
