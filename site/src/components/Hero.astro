---
// Home page intro, written for someone who has never heard of The ZAO.
// Plain on purpose: no background animation, no gradient text, no hand-typed
// numbers (the Fractal number comes from lib/week.ts, and index.astro keeps it
// current in the browser). Colors and fonts come from styles/global.css.

interface Props {
  weekNumber: number;
}
const { weekNumber } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-title">A weekly meeting where musicians and builders recognize each other's work</h1>

  <p class="hero-sub">
    ZAO Fractal is the weekly meeting of The ZAO. Every Monday, members meet in
    small groups, share what they worked on, and rank each other. That ranking
    becomes Respect: a permanent public record of who contributed.
  </p>

  <p class="hero-when">
    Mondays at 6pm EST, on Discord. This week is meeting number <span data-fractal-week>{weekNumber}</span>.
  </p>

  <div class="hero-cta">
    <a href="https://discord.thezao.com" class="btn btn-primary">Join the Discord</a>
    <a href="#how-it-works" class="btn btn-secondary non-members-only">How it works</a>
    <a href="/whitepaper" class="btn btn-secondary members-only">Read the whitepaper</a>
    <a href="/research" class="btn btn-secondary members-only">Browse the research</a>
  </div>
</section>

<style>
  .hero {
    max-width: var(--read-col, 720px);
    margin: 0 0 3rem;
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .hero-title {
    font-family: var(--font-display, 'Syne', system-ui, sans-serif);
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 60ch;
    margin: 0 0 1rem;
  }
  .hero-when {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0 0 1.75rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  @media (max-width: 600px) {
    .hero { padding: 2.5rem 0 2rem; }
  }
</style>
