---
// Home page intro. Plain on purpose: no background animation, no gradient
// text, no glow, no hand-typed numbers (the Fractal number comes
// from lib/week.ts, and index.astro keeps it current in the browser). Colors and fonts come only from the
// tokens in styles/global.css, with the old names as fallbacks so this works
// before and after the token PR lands. Live figures arrive later from ornode
// at build time (site/src/lib/ornode.ts, not yet written).

interface Props {
  weekNumber: number;
}
const { weekNumber } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-title">The ZAO's weekly Respect Game</h1>

  <p class="hero-sub">
    Every week, members meet in small random groups, usually six, rank each other's recent
    contributions, and earn Respect onchain on Optimism. Governance in The ZAO comes from
    contribution, not capital.
  </p>

  <p class="hero-when">
    Fractal <span data-fractal-week>{weekNumber}</span>. Mondays at 6pm EST, on Discord. Running weekly since August 2024.
  </p>

  <div class="hero-cta">
    <a href="/whitepaper" class="cta cta-primary">Read the whitepaper</a>
    <a href="/research" class="cta cta-secondary">Browse the research</a>
  </div>
</section>

<style>
  .hero {
    max-width: var(--read-col, 720px);
    margin: 0 0 3rem;
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .hero-title {
    font-family: var(--font-display, 'Syne', system-ui, sans-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 60ch;
    margin: 0 0 1rem;
  }
  .hero-when {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0 0 1.75rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius, 8px);
    font-family: var(--font-body, 'Outfit', system-ui, sans-serif);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .cta:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
  .cta-primary {
    background: var(--gold);
    color: var(--bg);
  }
  .cta-primary:hover {
    background: var(--text);
  }
  .cta-secondary {
    color: var(--text);
    border-color: var(--border);
  }
  .cta-secondary:hover {
    border-color: var(--text-muted);
  }
  @media (max-width: 600px) {
    .hero { padding: 2.5rem 0 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta { transition: none; }
  }
</style>
