---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'ZAO Fractal - the weekly Respect Game, ORDAO governance, and the lineage of fractal democracy.',
  ogImage,
  jsonLd,
} = Astro.props;
const fullTitle = title === 'ZAOfractal' ? title : `${title} - ZAOfractal`;
// Social card: use the passed per-page ogImage if it exists, else the branded
// default card (1200x630 PNG). Favicon SVG is a poor social card, so avoid it here.
const ogImageUrl = new URL(ogImage ?? '/og-default.png', Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site ? Astro.site.toString() : 'https://zaofractal.vercel.app/';
// Site-wide structured data (WebSite + Organization). Page-specific schema can be
// passed via the `jsonLd` prop and is rendered in addition to this.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'ZAOfractal',
      url: siteUrl,
      description:
        'The weekly Respect Game, 100+ weeks unbroken. Governance from contribution, not capital.',
    },
    {
      '@type': 'Organization',
      name: 'The ZAO',
      alternateName: 'ZAO Fractal',
      url: siteUrl,
      description:
        'A music community running the ZAO Fractal - a soulbound, peer-ranked weekly governance ritual on Optimism.',
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="fc:frame" content="vNext" />
  <meta name="fc:frame:image" content={ogImageUrl} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{fullTitle}</title>
  <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
  <script>
    // Copy-button handler for code blocks. Listens once, delegates to any .copy click.
    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element).closest('button.copy');
      if (!btn) return;
      const pre = btn.parentElement;
      if (!pre) return;
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      try {
        await navigator.clipboard.writeText(code.replace(/\n$/, ''));
        btn.classList.add('copied');
        btn.setAttribute('title', 'Copied!');
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.setAttribute('title', 'Copy');
        }, 1500);
      } catch (err) {
        btn.setAttribute('title', 'Copy failed');
      }
    });

    // Contract-address pills: also copy on click (in addition to opening Etherscan in new tab)
    document.addEventListener('click', async (e) => {
      const link = (e.target as Element).closest('a.contract-address');
      if (!link) return;
      if ((e as MouseEvent).altKey) {
        // alt+click copies without navigating
        e.preventDefault();
        const addr = link.getAttribute('data-address');
        if (addr) {
          try {
            await navigator.clipboard.writeText(addr);
            const orig = link.getAttribute('title');
            link.setAttribute('title', 'Copied!');
            setTimeout(() => { if (orig) link.setAttribute('title', orig); }, 1500);
          } catch (err) {}
        }
      }
    });
  </script>
</body>
</html>
