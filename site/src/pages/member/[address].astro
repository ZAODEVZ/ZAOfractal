---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  loadMembers,
  loadRespectSnapshot,
  loadAttendance,
  blockscout,
  tokenHoldings,
  type MemberProfile,
  type Attendance,
} from '../../lib/members';

export async function getStaticPaths() {
  const [members, attendance] = await Promise.all([loadMembers(), loadAttendance()]);
  return members.map((m) => ({
    params: { address: m.slug },
    props: { member: m, attended: attendance.get(m.slug) ?? [] },
  }));
}

const { member, attended } = Astro.props as { member: MemberProfile; attended: Attendance[] };
const periods = new Set(attended.map((a) => a.period)).size;
const txUrl = (h: string) => `https://optimism.blockscout.com/tx/${h}`;
const snap = await loadRespectSnapshot();
const fmt = (n: number) => n.toLocaleString('en-US');
const title = member.name ?? `${member.address.slice(0, 6)}...${member.address.slice(-4)}`;
---
<BaseLayout title={`${title} - Member`} description="A ZAO Fractal member's public profile: wallet, Respect and Respect Game history, from on-chain data.">
  <p class="muted"><a href="/member/">All members</a></p>
  <h1>{member.name ?? 'ZAO Fractal member'}</h1>

  <div class="wallet">
    <code id="wallet">{member.address}</code>
    <button type="button" class="btn btn-secondary btn-small" data-copy={member.address}>Copy</button>
  </div>
  <p class="muted">
    <a href={blockscout(member.address)} target="_blank" rel="noopener noreferrer">View on Blockscout</a>
  </p>

  <h2>Respect</h2>
  <div class="respect">
    <a class="tile" href={tokenHoldings(member.address, snap.zorContract)} target="_blank" rel="noopener noreferrer">
      <span class="num">{fmt(member.zorRespect)}</span>
      <span class="label">ZOR Respect<br />fractals 74 on</span>
    </a>
    <a class="tile" href={tokenHoldings(member.address, snap.ogContract)} target="_blank" rel="noopener noreferrer">
      <span class="num">{member.isOgTreasury ? '-' : fmt(member.ogRespect)}</span>
      <span class="label">OG Respect<br />fractals 1 to 73</span>
    </a>
    <div class="tile">
      <span class="num">{fmt(member.zorRespect + member.ogRespect)}</span>
      <span class="label">Total held</span>
    </div>
  </div>
  <p class="muted">
    Held balances on OP Mainnet, as of the snapshot pulled {snap.pulledAt.slice(0, 10)}. Each number links to Blockscout.
    {member.isOgTreasury && ' This wallet also holds the OG Respect treasury, so its OG balance is not shown as earned Respect.'}
  </p>

  <h2>Respect Game attendance</h2>
  {attended.length > 0 ? (
    <>
      <p class="muted">
        {periods} {periods === 1 ? 'period' : 'periods'} with a ZOR award, from {attended[attended.length - 1].date} to {attended[0].date}.
        Every rank earns Respect, so each award is a game this member played. Each row links its transaction.
      </p>
      <div class="att-table">
        <table>
          <thead><tr><th>Date</th><th>Period</th><th>Room</th><th>Rank</th><th>Respect</th></tr></thead>
          <tbody>
            {attended.map((a) => (
              <tr>
                <td><a href={txUrl(a.tx)} target="_blank" rel="noopener noreferrer">{a.date}</a></td>
                <td>{a.period}</td>
                <td>{a.room ?? '-'}</td>
                <td>{a.rank ?? '-'}</td>
                <td>{a.respect}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ) : (
    <p class="muted">No ZOR award on record for this wallet.</p>
  )}
  <p class="muted">
    Games before the ZOR contract (fractals 1 to 73, OG Respect) are on chain only as balances, not per game, so they are not listed here.
  </p>

  {!member.name && (
    <p class="muted">
      No public name. A name shows here only when the member picks one in ZAO OS and leaves this wallet visible there.
    </p>
  )}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = 'Copy'), 1500);
      } catch {
        b.textContent = 'Select and copy';
      }
    });
  });
</script>

<style>
  .wallet {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 1rem 0 0.5rem;
  }
  .wallet code {
    word-break: break-all;
    font-size: 0.95rem;
  }
  .respect {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.12));
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
  }
  .tile .num {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--orange, #e55611);
  }
  .att-table {
    overflow-x: auto;
  }
  .att-table table {
    margin: 0.5rem 0;
  }
  .tile .label {
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
